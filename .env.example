# ═══════════════════════════════════════════
# Google Sheets Integration
# ═══════════════════════════════════════════

# ID del proyecto en Google Cloud Console
GOOGLE_PROJECT_ID=

# Email del servicio (service account) en Google Cloud
GOOGLE_CLIENT_EMAIL=

# Private key del servicio (copiar completa, incluyendo BEGIN/END PRIVATE KEY)
# En .env.local usa \n para saltos de línea
GOOGLE_PRIVATE_KEY=

# ID del Google Sheet (la URL entre /d/ y /edit)
# Ejemplo: https://docs.google.com/spreadsheets/d/ESTO_ES_EL_ID/edit
GOOGLE_SHEET_ID=

# Rango a leer (por defecto A1:Z1000)
GOOGLE_SHEET_RANGE=A1:Z1000
